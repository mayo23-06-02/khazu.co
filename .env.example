# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://khazu.co.sz

# ── EmailJS (signup verification codes) ─────────────────────────────────
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Dev only: skip issuing/checking verification codes entirely. Never set
# this to "true" in production.
SKIP_EMAIL_VERIFICATION=true

# ── RazPay (MTN MoMo collections) ───────────────────────────────────────
# https://razpay.razonetix.com/docs — fronts the MTN Collections API for
# subscription/boost checkout (lib/subscriptions/momo.ts). Without these,
# any paid checkout (dealer/individual plans, listing boosts) fails with
# "RAZPAY_API_KEY is not configured".
RAZPAY_BASE_URL=https://api.razpay.razonetix.com/v1
RAZPAY_API_KEY=
